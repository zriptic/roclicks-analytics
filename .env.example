# Postgres. docker-compose.yml starts one that matches this.
DATABASE_URL="postgres://analytics:analytics@localhost:5432/analytics"

# Sign-in for the dashboard. Pick your own.
ADMIN_PASSWORD="change-me"
# Random string, 16+ characters. Changing it signs everyone out.
# Make one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Where Roblox servers can reach this app, without a trailing slash.
# Roblox can't reach localhost: for a real game use a public URL
# (your server, or a tunnel like ngrok / cloudflared while testing).
# Leave empty to use the address the dashboard is opened on.
PUBLIC_URL=""

# Optional
# ANALYTICS_EVENTS_PER_MONTH=100000000
# ANALYTICS_MAX_GAMES=100
# ANALYTICS_RETENTION_DAYS=180
# ANALYTICS_STUDIO_RETENTION_DAYS=30
# ANALYTICS_RATE_PER_KEY=100
# ANALYTICS_BURST_PER_KEY=500
# ANALYTICS_PRUNE_CRON="15 4 * * *"
