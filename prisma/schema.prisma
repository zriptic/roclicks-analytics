// RoClicks Analytics: the analytics tables from roclicks.gg, standalone.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AnalyticsGame {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  /// Public SDK key ("rca_" + random). Safe to ship in game code: it can
  /// only write markers and read this game's config.
  sdkKey    String   @unique
  createdAt DateTime @default(now())

  /// Last time any server sent a batch, for the "connected" badge.
  lastIngestAt DateTime?

  /// USD per earned Robux for the revenue estimate. 0.0038 is the standard
  /// DevEx rate; 0.0054 applies to some US 18+ purchases in eligible games;
  /// balances earned before 2025-09-05 still cash out at 0.0035.
  devexRate Float @default(0.0038)

  players    AnalyticsPlayer[]
  sessions   AnalyticsSession[]
  events     AnalyticsEvent[]
  activeDays AnalyticsActiveDay[]
  configs    AnalyticsConfig[]
  usage      AnalyticsUsage[]
  purchases  AnalyticsPurchase[]
  experiments AnalyticsExperiment[]

  @@index([ownerId])
}

/// One row per Roblox user per game per env. firstSeenAt is the retention cohort.
model AnalyticsPlayer {
  gameId       String
  game         AnalyticsGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  env          String
  robloxUserId BigInt
  firstSeenAt  DateTime
  lastSeenAt   DateTime
  sessionCount Int           @default(0)
  playSeconds  Int           @default(0)
  country      String?

  @@id([gameId, env, robloxUserId])
  @@index([gameId, env, firstSeenAt])
}

model AnalyticsSession {
  /// Generated by the SDK, so a retried batch can't double count.
  id           String        @id
  gameId       String
  game         AnalyticsGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  env          String
  robloxUserId BigInt
  serverId     String
  placeId      BigInt?
  startedAt    DateTime
  /// Updated by every heartbeat. A session whose server crashed never gets
  /// endedAt, so its length is lastSeenAt - startedAt.
  lastSeenAt   DateTime
  endedAt      DateTime?
  country      String?
  device       String?

  @@index([gameId, env, startedAt])
  @@index([gameId, env, lastSeenAt])
}

/// Markers: anything the game calls Track() with.
model AnalyticsEvent {
  id           BigInt        @id @default(autoincrement())
  gameId       String
  game         AnalyticsGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  env          String
  name         String
  robloxUserId BigInt?
  sessionId    String?
  value        Json?
  x            Float?
  y            Float?
  z            Float?
  at           DateTime

  @@index([gameId, env, at])
  @@index([gameId, env, name, at])
}

/// One row per player per UTC day they played. DAU and retention read this.
model AnalyticsActiveDay {
  gameId       String
  game         AnalyticsGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  env          String
  robloxUserId BigInt
  day          DateTime      @db.Date

  @@id([gameId, env, day, robloxUserId])
}

model AnalyticsConfig {
  gameId    String
  game      AnalyticsGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  env       String
  values    Json
  version   Int           @default(1)
  updatedAt DateTime      @updatedAt

  @@id([gameId, env])
}

/// Monthly marker count for the free quota. month = "2026-10".
model AnalyticsUsage {
  gameId String
  game   AnalyticsGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  month  String
  events Int           @default(0)

  @@id([gameId, month])
}

/// One sale. `robux` is what the player paid (receipt CurrencySpent, so
/// regional pricing and price tests are already in it); `netRobux` is what
/// the game owner keeps after Roblox's cut, using the share in force at the
/// time, so changing the share table later doesn't rewrite history.
model AnalyticsPurchase {
  id           BigInt        @id @default(autoincrement())
  gameId       String
  game         AnalyticsGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  env          String
  /// Receipt PurchaseId for developer products, so a receipt Roblox retries
  /// is stored once. SDK-generated for other kinds.
  purchaseId   String
  robloxUserId BigInt
  sessionId    String?
  /// product | pass | subscription | private_server | avatar_item | other
  kind         String
  itemId       BigInt?
  itemName     String?
  robux        Int
  share        Float
  netRobux     Int
  at           DateTime

  @@unique([gameId, purchaseId])
  @@index([gameId, env, at])
}

/// A/B test on one remote config key. Each player is put in one variant by
/// a hash of (experiment id, user id), so they get the same value on every
/// server and every visit without the API remembering anything.
model AnalyticsExperiment {
  id        String        @id @default(cuid())
  gameId    String
  game      AnalyticsGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  env       String
  name      String
  /// Config key the variants replace, e.g. "starterCoins" or "shop.price".
  key       String
  /// [{ name, value, weight }]. The first variant is the control.
  variants  Json
  /// Optional marker that counts as the goal, e.g. "LevelUp".
  goal      String?
  /// "running" or "stopped". Only running tests are sent to servers.
  status    String        @default("running")
  /// Variant kept when the test was stopped, if any.
  winner    String?
  startedAt DateTime      @default(now())
  stoppedAt DateTime?

  exposures AnalyticsExposure[]

  @@index([gameId, env, status])
}

/// First time a player was given a variant. Results only count what each
/// player did after this moment.
model AnalyticsExposure {
  experimentId String
  experiment   AnalyticsExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  robloxUserId BigInt
  variant      String
  at           DateTime

  @@id([experimentId, robloxUserId])
}
